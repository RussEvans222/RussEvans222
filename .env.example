# Get your Anthropic key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Get your OpenAI key at https://platform.openai.com/api-keys
# Required for image generation (DALL-E 3, ~$0.04 per image)
OPENAI_API_KEY=sk-your-openai-key-here

# Port for the Express server (optional, defaults to 3001)
PORT=3001
